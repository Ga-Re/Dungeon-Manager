{
  "name": "@dungeon-manager/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Tauri desktop app: DM window and player window.",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "vite": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "preview:e2e": "vite preview --mode e2e",
    "typecheck": "tsc -p tsconfig.json",
    "tauri": "tauri",
    "build:app": "tauri build --debug --no-bundle",
    "smoke": "node smoke/run.js",
    "spike": "VITE_SPIKE=1 tauri dev",
    "spike:video": "bash spike/make-video.sh"
  },
  "dependencies": {
    "@dungeon-manager/core": "workspace:*",
    "@dungeon-manager/i18n": "workspace:*",
    "@dungeon-manager/protocol": "workspace:*",
    "@dungeon-manager/renderer": "workspace:*",
    "@dungeon-manager/schema": "workspace:*",
    "@dungeon-manager/storage": "workspace:*",
    "@dungeon-manager/ui": "workspace:*",
    "@tauri-apps/api": "2.12.4",
    "i18next": "27.1.2",
    "lucide-react": "1.68.0",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1"
  },
  "devDependencies": {
    "@dungeon-manager/tsconfig": "workspace:*",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8"
  }
}
