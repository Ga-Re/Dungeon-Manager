{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dm",
  "description": "DM window: list displays, open/move the player window, send it the projected scene, and access the library folder the DM chose (paths confined to it in Rust). The player window has its own capability (player.json): listening for events only.",
  "windows": ["dm"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-simple-fullscreen",
    "core:window:allow-set-position",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "allow-library-root",
    "allow-library-choose",
    "allow-library-read",
    "allow-library-read-image",
    "allow-library-write",
    "allow-library-list",
    "allow-library-make-directory",
    "allow-library-import-map",
    "allow-library-move-to-trash",
    "allow-library-subscribe"
  ]
}
