{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dungeon Manager",
  "version": "0.0.0",
  "identifier": "app.dungeon-manager.desktop",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:1420/dm.html",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "dm",
        "title": "Dungeon Manager",
        "url": "dm.html",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
